<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- 守护服务 specialUse 类型（API 34+ 强制要求前台服务声明 type） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 存储权限: 仅 API 26-28 写入 DCIM 需要，API 29+ 用 MediaStore 不需要 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 网络权限: 远程配置下发 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 唤醒锁: 拍摄期间短暂保持CPU运行 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 精确闹钟: 确保拍摄间隔准确（API 31+ 需要，旧版自动生效） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 电池优化白名单: 跳转到设置页不需要权限，但用于保活提示 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".TimeLapseApplication"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeLapseCamera"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务: 每次拍摄时短暂运行，拍完即停 -->
        <service
            android:name=".service.CaptureService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- 守护服务: 独立进程，检测主服务并自动重启（specialUse: Android 14+ 前台服务必须声明类型） -->
        <service
            android:name=".service.WatchdogService"
            android:foregroundServiceType="specialUse"
            android:process=":watchdog"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="watchdog_keepalive" />
        </service>

        <!-- 广播接收器: 接收AlarmManager定时唤醒 -->
        <receiver
            android:name=".scheduler.CaptureReceiver"
            android:exported="false" />

        <!-- 开机自启: 恢复拍摄计划 -->
        <receiver
            android:name=".scheduler.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
